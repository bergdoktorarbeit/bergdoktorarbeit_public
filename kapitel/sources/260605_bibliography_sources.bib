@misc{MaxwellRosenblum.2025,
 abstract = {Apple's choice of Tahoe as an operating system name functions less like branding and more like demand creation. Repeated exposure inside a daily-use interface lowers search costs and nudges travel intent long before any conscious decision is made. The result is synchronized interest, not because people were persuaded, but because the option became cognitively available at scale.



The economic impact is asymmetric. Attention scales instantly, while roads, parking, waste systems, and environmental management do not. Visitation rises without matching investment, shifting costs onto local governments and residents. Value flows to the platform through association, while congestion and maintenance remain local problems. As more demand is shaped upstream by digital interfaces, the key question becomes who triggers economic activity, and who absorbs the externalities once it arrives.},
 author = {{Maxwell Rosenblum}},
 year = {2025},
 title = {The economic impact of MAC OS Tahoe},
 url = {\url{https://www.instagram.com/p/DT3Llb1Dyg_/}},
 keywords = {63.16MT;Apple;Big sur;Branding;brandstrategy;California;economics;media tourism;naming strategy;overtourism;tahoe;Tourism;United States;yosemity},
 address = {Washington},
 urldate = {31.01.2026},
 file = {Maxwell Rosenblum 2025 - The economic impact of MAC:Attachments/Maxwell Rosenblum 2025 - The economic impact of MAC.pdf:application/pdf}
}


@article{Schiavone.2022,
 abstract = {The current article focuses on the cultural practice of four film tours in Edinburgh, Scotland, analysing how film tours like these contribute to more general placemaking processes. Prior research has shown how film tours have become a staple of the tourist consumption of many contemporary cities. Building on these studies, the current article focuses explicitly on one of the defining features of these tours, namely the fictional character of their central topic. More particularly, this study examines how film tours are built up around a presumed conflation of imagined and material space. It argues that film tours are forms of cultural `work' in which fictional plotlines from cinema are integrated into and used to revitalize notions of place. Through these practices, cinematic fiction eventually becomes part of what is experienced as the `true core' of Edinburgh.},
 author = {Schiavone, Rosa and Reijnders, Stijn},
 year = {2022},
 title = {Fusing fact and fiction: Placemaking through film tours in Edinburgh},
 keywords = {31.15SC;Cinematic Heritage;Edinburgh;fiction;Film tourism;Film Tours;imaginative geographies;placemaking;popular culture;scotland;UK},
 pages = {723--739},
 volume = {25},
 number = {2},
 issn = {1367-5494},
 journal = {European Journal of Cultural Studies},
 doi = {\url{10.1177/1367549420951568}},
 file = {241219{\_}Fusing fact and fiction - Placemaking through film tours in Edinburghs{\_}Schiavone, Reijnders (2020):Attachments/241219{\_}Fusing fact and fiction - Placemaking through film tours in Edinburghs{\_}Schiavone, Reijnders (2020).pdf:application/pdf;250511{\_}Fusing fact and fiction - Placemaking through film tours in Edinburgh{\_}Schiavone, Reijnders:Attachments/250511{\_}Fusing fact and fiction - Placemaking through film tours in Edinburgh{\_}Schiavone, Reijnders.pdf:application/pdf}
}


@article{Benjamin.2019,
 abstract = {Film-induced festivals are becoming more popular, generated through accessibility of streaming platforms and acceptance for popular culture fandom. This is different than any general film festival, because there is a sense of community and desire for recreation among film-induced festival attendees, who are seeking a very specific feel and experience. This excitement can also spill over into the surrounding community, thus sparking interest with festival organizers and community hospitality and retail business owners. Knowing what experiences film-induced festival attendees are seeking can potentially increase visitation, facilitate positive word of mouth, and promote return intentions. This study explored The 2017 Dirty Dancing Festival at Lake Lure, NC, USA where social media posts were collected to understand how attendees experienced the festival. Informed by cocreation theory and a qualitative content analysis, seven themes related to the lived experiences of festival attendees were identified providing in-depth information on attendees' expectations of film-induced festivals. Their experiences related to recreating film scenes and scouting film locations helped to contribute evidence for how festival organizers can maximize cocreation through film-induced festivals using social media posts.},
 author = {Benjamin, Stefanie and Knollenberg, Whitney and Chen, Rachel},
 year = {2019},
 title = {Making Sure They Have the Time of Their Lives: Identifying Cocreation Opportunities at the Dirty Dancing Festival},
 keywords = {31.20SC;co-creation;Community;Dirty Dancing;fandom;festival;film induced;Lake Lure;popular culture;recreating;screen tourism;streaming;United States},
 pages = {613--626},
 volume = {23},
 number = {4},
 issn = {1525-9951},
 journal = {Event Management},
 doi = {\url{10.3727/152599519X15506259855706}}
}


@book{vanEs.2021,
 abstract = {Locating Imagination in Popular Culture offers a multi-disciplinary account of the ways in which popular culture, tourism and notions of place intertwine in an environment characterized by ongoing processes of globalization, digitization and an increasingly ubiquitous nature of multi-media.

Centred around the concept of imagination, the authors demonstrate how popular culture and media are becoming increasingly important in the ways in which places and localities are imagined, and how they also subsequently stimulate a desire to visit the actual places in which people's favourite stories are set. With examples drawn from around the globe, the book offers a unique study of the role of narratives conveyed through media in stimulating and reflecting desire in tourism.

This book will have appeal in a wide variety of academic disciplines, ranging from media and cultural studies to fan- and tourism studies, cultural geography, literary studies and cultural sociology.},
