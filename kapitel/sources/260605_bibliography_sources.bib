@article{Deuze.2011,
 abstract = {ChatGPT:

This article argues that in contemporary society, people no longer live with media but in media. Deuze proposes an ontological shift in media studies, suggesting that media are not external technologies or symbolic systems but integral to the human condition and everyday experience. As media become ubiquitous and invisible, they blur boundaries between public and private, work and play, reality and representation. Drawing on theorists such as Kittler, Castells, and Bauman, Deuze conceptualizes ``media life'' as the defining state of 21st-century existence---where identity, sociality, and reality itself are continuously produced and remixed through media. Through metaphors like The Truman Show, he explores how individuals navigate self-creation, surveillance, and agency in a fully mediated world. Ultimately, the paper calls for media studies to adopt this ontological perspective to better understand how people live, act, and constitute meaning within the total mediation of life.},
 author = {Deuze, Mark},
 year = {2011},
