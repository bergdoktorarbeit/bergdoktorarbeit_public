@phdthesis{Munch.15.07.2019,
 abstract = {This thesis examines the key characteristics of moving pictures as part of the brand

communication mix and its integration in tourism. It furthermore elaborates on future

assessments by conducting explorative and qualitative research with altogether eight experts.

In order to conduct the research, theoretical concepts affecting the application of moving

pictures are reviewed. Literature regarding media historical developments, concerning

neuromarketing insights and in regard to modern marketing communications serves the

establishment of a conceptual framework and has been adapted to develop a semi-structured

interview guide. The results suggest practical as well as theoretical implications. Moving

pictures are claimed to be more powerful than any other media and are characterized by the

ability to emotionalize with the recipient. In addition, moving pictures enable to reach all target

groups, independent from segmentation characteristics. Furthermore, the conducted research

has proven the need to engage with the target audience to the same extent as with the brand

and to gain insights into the values of both perspectives that is paramount for the creation of

moving pictures. By applying these insights, moving pictures contribute to the virtual

experience of tourists, especially in the pre-travel and inspiration phase. Thus, branded moving

pictures count as enrichment for both, the sender of the message as well as for the receiver.

In regard to future assessments, experts do expect moving pictures to be increasingly

implemented in the field of brand communication due to the increase of acknowledgment and

technological enhancements.},
 author = {M{\"u}nch, Viktoria},
 year = {15.07.2019},
 title = {Branded moving pictures: Brand communication of destination brands with moving pictures},
 keywords = {39SA;brand communication;modern marketing communication;moving pictures;Tourism;virtual experience},
 address = {Salzburg},
 publisher = {Master Degree Program {\textquotedbl}Innovation and Management in Tourism{\textquotedbl}},
 school = {{University of Applied Sciences Salzburg}},
 type = {Masterarbeit},
 file = {39SA{\_}BRANDED MOVING PICTURES{\_}M{\"u}nch:Attachments/39SA{\_}BRANDED MOVING PICTURES{\_}M{\"u}nch.pdf:application/pdf;20200516{\_}BRANDED MOVING PICTURES{\_}M{\"u}nch, Victoria:Attachments/20200516{\_}BRANDED MOVING PICTURES{\_}M{\"u}nch, Victoria.pdf:application/pdf}
}


@article{Munar.2014,
 abstract = {Based on a destination-specific survey, this study charts and explores summer holidaymakers' motivations

for social media contributions and their willingness to share content through various social media.

The findings in relation to the much-visited destination of Mallorca offer an understanding of the

adoption of tourist social media in technologically-advanced markets with high levels of ICT use. The

results provide insights into such motivational factors as personal and community-related benefits as

well as the social capital that influences a sharing of user-generated content. The study reveals a

dominance of visual content, along with the relevance of altruistLc and community-related motivations

and motivational differences between {\~{}}pes of content creators Sharing practices through social meoia

appear as valuable articulations of sociability ano emotional support, while having lesser relevance as

information sources for holiday decision-making. he paper additionally shows the extent to which old

and new technologies over ap an complement each other.

{\copyright}},
