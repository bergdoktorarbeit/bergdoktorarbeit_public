@article{Jansson.2018,
 abstract = {The article explores how the culture of spreadable social media affects post-tourism, and, by

extension, the boundaries of tourism. Post-tourism is understood as a generalized social condition

that entails de-differentiation between tourism and other social realms as well as a complex set of

reactions against this predominant trend. Through a case study of urban explorers the article

demonstrates how spreadable media impose new layers of reflexivity and hesitation as to whether

and how to share tourist representations. While spreadable media provide resources for

personalized communication they also make it more difficult to uphold cultural boundaries and

distinctions. Differences in handling spreadability testify to the extended role of post-tourism as a

site of symbolic struggle among the aspirational middle classes.},
 author = {Jansson, Andr{\'e}},
 year = {2018},
 title = {Rethinking post-tourism in the age of social media},
 keywords = {67ST;Distinction;Identity;Post-tourism;Reflexivity;Social Media;Urban exploration},
 pages = {101--110},
 volume = {69},
 journal = {Annals of Tourism Research},
 doi = {\url{10.1016/j.annals.2018.01.005}},
 file = {20190905{\_}Rethinking post-tourism in the age of social media{\_}Jansson, A.:Attachments/20190905{\_}Rethinking post-tourism in the age of social media{\_}Jansson, A..pdf:application/pdf;67ST{\_}Rethinking post-tourism in the age of social media{\_}Andre Jansson:Attachments/67ST{\_}Rethinking post-tourism in the age of social media{\_}Andre Jansson.pdf:application/pdf}
