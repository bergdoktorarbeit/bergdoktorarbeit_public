@article{Tussyadiah.2016,
 abstract = {This study investigates the relationships between traveler innovativeness traits and the patterns of

smartphone use during the experiential stage of tourism experience. Using data collected from

1126 travelers residing in the United States (US), it was identified that tourism innovativeness

and technology innovativeness have significant positive effects on on-site use of smartphones for

trip management, social networking, as well as searching deals, online consumer reviews, and

push recommendations. In addition, technology innovativeness also positively influences

smartphone use for navigation within destinations. The results suggest that highly innovative

travelers are not only heavy users of smartphones for travel, they are also open to

recommendations and influences when making on-site decisions. This makes the market segment

an effective target for destinations and tourism businesses applying context-based marketing

strategies to push recommendations for travelers on the move.},
 author = {Tussyadiah, Iis P.},
 year = {2016},
 title = {The Influence of Innovativeness on On-Site Smartphone Use Among American Travelers: Implications for Context-Based Push Marketing},
 keywords = {170TS;consumer innovativeness;context-based marketing;push recommendation;Smartphone;travel apps},
 pages = {806--823},
 volume = {33},
 number = {6},
 issn = {1054-8408},
 journal = {Journal of Travel {\&} Tourism Marketing},
 doi = {\url{10.1080/10548408.2015.1068263}},
 file = {170TS{\_}05122021{\_}174307:Attachments/170TS{\_}05122021{\_}174307.pdf:application/pdf;20191208{\_}The Influence of Innovativeness on On-Site Smartphone Use among American Travelers{\_}Lis P Tussyadiah:Attachments/20191208{\_}The Influence of Innovativeness on On-Site Smartphone Use among American Travelers{\_}Lis P Tussyadiah.pdf:application/pdf}
