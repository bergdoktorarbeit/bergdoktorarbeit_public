@article{vanHouse.2011,
 abstract = {Photography has been a wildly successful consumer technology. The shift from film to digital has, if anything, increased both photographic activity and enthusiasm on the part of photographers, viewers and subjects. In this article, I address empirically and theoretically the practical doing of ordinary, daily photography as it has moved from film to digital. I describe findings from my own empirical work over several years with a wide range of people engaged in both film and digital photographic technologies, including camera-phones and online image-sharing. Current developments in digital image-related technologies are changing the publicness, temporality and volume of personal photographic images. I describe personal photography as, in effect, multiple, overlapping technologies: of memory; relationships; self-representation; and self expression, all of which are changing in the digital environment. I draw on science and technology studies (STS) for help in understanding photography as an on-going practice of assemblage and performance, and the changes in photographic technologies as an opportunity to see technology-in-the-making -- the activities by which people are reproducing sociomaterial relations. In this view, photographs have agency as they `take the relay' across space and time. With digital technology we see shifts in the assemblages of objects, practices and meanings that we call personal photography, some of which may be more welcome than others. In particular, personal photographs may be becoming more public and transitory, less private and durable and more effective as objects of communication than of memory.},
 author = {{van House}, Nancy A.},
 year = {2011},
 title = {Personal photography, digital technologies and the uses of the visual},
 keywords = {166.8TS;communication;consumption;daily life;digital;image sharing;memory;performance;photography;practice;public;relationship;Sharing;Smartphone;technology;transitory;visual},
 pages = {125--134},
 volume = {26},
 number = {2},
 issn = {1472-586X},
 journal = {Visual Studies},
 doi = {\url{10.1080/1472586X.2011.571888}},
 file = {260705{\_}Personal photography digital technologies and the uses of the visual{\_}van House:Attachments/260705{\_}Personal photography digital technologies and the uses of the visual{\_}van House.pdf:application/pdf}
}



@article{vanHouse.2009,
 abstract = {This article reports empirical findings from four inter-related studies, with an emphasis on collocated sharing. Collocated sharing remains important, using both traditional and emerging image-related technologies. Co-present viewing is a dynamic, improvisational construction of a contingent, situated interaction between story-teller and audience. The concept of performance, as articulated differently by Erving Goffman and Judith Butler, is useful understand the enduring importance of co-present sharing of photos and the importance of oral narratives around images in enacting identity and relationships. Finally, we suggest some implications for both HCI research and the design of image-related technologies.},
 author = {{van House}, Nancy A.},
 year = {2009},
 title = {Collocated photo sharing, story-telling, and the performance of self},
 keywords = {166.9TS;Identity;narratives;photo;photography;relationship;Sharing;storytelling},
 pages = {1073--1086},
 volume = {67},
 number = {12},
 issn = {10715819},
 journal = {International Journal of Human-Computer Studies},
 doi = {\url{10.1016/j.ijhcs.2009.09.003}}
}



@article{Mele.2023,
 abstract = {Alpine tourism is one of the most popular forms of travel. Despite the prominence of information and communication technology in shaping travel perceptions and behaviour, a research gap has been identified concerning how this phenomenon is represented online. By taking the case of Alpine tourism in Switzerland, in this qualitative research we use a thematic content analysis to investigate themes and narratives about Alpine landscape and tourism in 158 blog posts. Findings show, first, that Alpine tourism representations can be grouped into six themes: Accessible Mountains, Captured Landscapes, Isolated Land, Healing Place, Cultural Discovery, and Natural Heritage. Second, representational narratives that can be ascribed to the Authorised Heritage Discourse appear to coexist with counter-narratives where the purely visual and aesthetic aspects of the Alps are combined with critical, experiential, and cultural elements. Research implications include the role of visual experiences in heritage representation and commodification, and the importance of integrating blogs in mountain tourism destination websites.},
 author = {Mele, Emanuele and Egberts, Linde},
 year = {2023},
 title = {Exploring travel blogs on tourism and landscape heritage: representations of the Swiss Alps},
 keywords = {94.2ST;Alpine landscape;alps;Authorised heritage discourse;Mountain tourism;Switzerland;Thematic content analysis;Travel blogs},
 pages = {785--806},
 volume = {18},
 number = {6},
 issn = {1743-873X},
 journal = {Journal of Heritage Tourism},
 doi = {\url{10.1080/1743873X.2023.2237617}},
 file = {260705{\_}Exploring travel blogs on tourism and landscape heritage representations of the Swiss Alps{\_}Mele and Egberts{\_}2023:Attachments/260705{\_}Exploring travel blogs on tourism and landscape heritage representations of the Swiss Alps{\_}Mele and Egberts{\_}2023.pdf:application/pdf}
}



@article{Lexhagen.2023,
 abstract = {Popular culture tourism encompasses a range of expressive practices that attract fans traveling to destinations associated with their fandom pursuit. However, scholarship on this multifaceted phenomenon is today over-fragmented and obscured by separate disciplinary agendas and priorities. We argue that the scope and breadth of popular culture tourism calls for its interdisciplinary treatment as a distinct field. Through a scoping literature review, this paper identifies the foundational elements of its conceptual and ontological roots, extracting key insights and discursive themes that can help establish a comprehensive perspective on the study and management of popular culture tourism. Our inquiry builds common ground that can shed light on the complexity of popular culture expressions and enable their strategic role as a destination placemaking tool. Thematic areas of convergence resulting in the emergent configuration of the field are delineated, and primary research questions for the comprehensive study of popular culture tourism are outlined.},
 author = {Lexhagen, Maria and Ziakas, Vassilios and Lundberg, Christine},
 year = {2023},
 title = {Popular Culture Tourism: Conceptual Foundations and State of Play},
 keywords = {61.25SA;destination placemaking, sport and recreation, leisure and events;fans and fandom;media;popular culture tourism},
 pages = {1391--1410},
 volume = {62},
 number = {7},
 issn = {0047-2875},
 journal = {Journal of Travel Research},
 doi = {\url{10.1177/00472875221140903}},
 file = {260706{\_}popular-culture-tourism-conceptual-foundations-and-state-of-play{\_}lexhagen-et-al{\_}2022:Attachments/260706{\_}popular-culture-tourism-conceptual-foundations-and-state-of-play{\_}lexhagen-et-al{\_}2022.pdf:application/pdf;Lexhagen, Ziakas et al 2023 - Popular Culture Tourism:Attachments/Lexhagen, Ziakas et al 2023 - Popular Culture Tourism.pdf:application/pdf}
}



