@article{Buchmann.2010b,
 abstract = {This paper is part of a larger study into the expectations and experiences of guided

Lord of the Rings film tourists during their visits to more than 80 locations/settings that were

featured in the films, and here discusses the demands towards and developments of the supply

side of the thriving Lord of the Rings film tourism industry in Aotearoa, New Zealand.

The challenges of guiding film tourists through their confrontation of anticipated fantastical

landscape and geographical reality is discussed, leading to the identification of a typical film tour

