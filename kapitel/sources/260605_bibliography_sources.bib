@article{Antunes.2018,
 abstract = {Increasingly, tourist information on the Internet comes from the content generated by users,

being no longer limited to the communications of tourism professionals and government

entities. At the same time, the comments, opinions and reviews made by consumers are the

type of information which tourists value the most. This reality means that the Internet has

become an extremely valuable source of information for prospective travelers. This study

aims to identify and characterize the behavior patterns of tourists on social media during

and after their travels, specifically: who are the tourists who create content, what leads

them to have this initiative, and what behaviors stand out on each of these platforms. The

methodology is based on a questionnaire survey, which was applied to tourists. The data

was analyzed using descriptive statistical methods, cluster analysis and principal component

analysis. It is possible to categorize tourists according to three perspectives regarding use of

social media during and after the trip: those who prefer review websites, those who prefer

social networks and those who don't particularly use social media in general},
 author = {Antunes, Nuno and Ramos, C{\'e}lia and Sousa, Carlos},
 year = {2018},
 title = {Who are the tourists sharing content on social media? Behaviour and characteristics},
 url = {\url{https://www.researchgate.net/publication/327945032_Who_are_the_tourists_sharing_content_on_social_media_Behaviour_and_characteristics}},
 keywords = {105.2DT;internet;NICHT GEFUNDEN - VERSCHWUNDEN;Review Websites;Social Media;Social Networks;Tourist-Generated Content;ugc;user-generated content},
 urldate = {25.01.2024},
 pages = {237--257},
 volume = {6},
 number = {3},
 journal = {Journal of Tourism, Sustainability and Well-being},
 file = {20190903{\_}WHO ARE THE TOURISTS SHARING CONTENT ON SOCIAL MEDIA - BEHAVIOUR AND CHARACTERISTICS{\_}Celia Ramos:Attachments/20190903{\_}WHO ARE THE TOURISTS SHARING CONTENT ON SOCIAL MEDIA - BEHAVIOUR AND CHARACTERISTICS{\_}Celia Ramos.pdf:application/pdf}
}


@article{Angley.2014,
 abstract = {Social media is the number one activity on the internet that is used by one and a half billion users every year. These online platforms are

greatly benefiting the tourism industry as it offers many different marketing opportunities, targeting channels and significantly influences the

tourist's decisions. The Irish tourism industry are commencing their social media strategies beginning from the Destination Marketing

Organisation and National Tourism Development Authority, however some industry operators such as visitor attractions, are not yet fully

utilising the obtainable marketing opportunities. This research is focusing on three visitor attractions in three particular sectors of the tourism

industry, heritage, urban and natural. The aim of the research is to determine what efforts are currently in place with their existing social media

campaigns and what can be done to improve the return on investment. Perhaps the identification of a future social media strategy for Irish

visitor attractions can result in the successful re-development of a company's overall marketing strategy. Further to this identification, the main

objective of selecting visitor attractions from three sectors of the tourism industry is to determine if social media content should be focused on

sectors of the tourism industry. The research was obtained through a mixed methodology containing primary and secondary research, using

qualitative and quantitative results. The first stage was to carry out a literature review to identify gaps in the research. Books, articles, E-journals,

websites and F{\'a}ilte Ireland reports were examined to initially distinguish existing literature views regarding the best approach tourism industry

operators should take in relation to their social media campaigns. Following the findings of the literature review, the researcher examined the

information and the gaps further by conducting three interviews with visitor attraction operators and carrying out sixty questionnaires with

previous tourists of the three attractions under review. Each objective of the research study was answered and recommendations were

established for the future of visitor attractions social networking campaigns. It is now evident that the future of marketing for tourism

organisations will be through social networking mediums, therefore not adapting or embracing this marketing tool will subsequently effect the

marketing achievements of the company.},
 author = {Angley, Dawn and O'Byrne-Prior, June and O'Connor, No{\"e}lle},
 year = {2014},
 title = {Visitor Attractions: The Future of Social Media in Heritage, Urban and Natural Tourism},
 keywords = {63MT;Heritage Attraction;Ireland;Natural Attraction;Social Media;Urban Attraction},
 pages = {326--340},
 volume = {6},
 number = {4},
 journal = {International Hospitality and Tourism Student Journal},
 file = {63MT{\_}Visitor Attractions - The Future of Social Media in Heritage, Urban and Natural Tourism{\_}Angley {\&} O'Byrne-Prior {\&} O'COnnor:Attachments/63MT{\_}Visitor Attractions - The Future of Social Media in Heritage, Urban and Natural Tourism{\_}Angley {\&} O'Byrne-Prior {\&} O'COnnor.pdf:application/pdf;20191226{\_}Visitor Attractions The Future of Social Media in Heritage, Urban and Natural Tourism{\_}Dr Noelle Connor:Attachments/20191226{\_}Visitor Attractions The Future of Social Media in Heritage, Urban and Natural Tourism{\_}Dr Noelle Connor.pdf:application/pdf}
