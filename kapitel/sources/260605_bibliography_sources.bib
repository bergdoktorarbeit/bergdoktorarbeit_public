 doi = {\url{10.1016/j.tourman.2016.11.023}},
 file = {31.3SC{\_}The economic impact of on-screen tourism - The case of The Lord of the Rings and the Hobbit{\_}Li {\&} Li {\&} Song {\&} Lundberg {\&} Shen:Attachments/31.3SC{\_}The economic impact of on-screen tourism - The case of The Lord of the Rings and the Hobbit{\_}Li {\&} Li {\&} Song {\&} Lundberg {\&} Shen.pdf:application/pdf;20191019{\_}The economic impact of on-screen tourism The case of The Lord of{\_}Shina Li:Attachments/20191019{\_}The economic impact of on-screen tourism The case of The Lord of{\_}Shina Li.PDF:application/pdf}
