 file = {20190905{\_}Measuring the Effects of Film and Television on Tourism to Screen Locations - A Theoretical and Empirical Perspective{\_}Young, A.F.:Attachments/20190905{\_}Measuring the Effects of Film and Television on Tourism to Screen Locations - A Theoretical and Empirical Perspective{\_}Young, A.F..pdf:application/pdf;51SA{\_}Measuring the Effects of Film and Television on Tourism to Screen Locations{\_}young {\&} Young:Attachments/51SA{\_}Measuring the Effects of Film and Television on Tourism to Screen Locations{\_}young {\&} Young.pdf:application/pdf}
