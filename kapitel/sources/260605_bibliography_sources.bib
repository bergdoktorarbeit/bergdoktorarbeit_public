@book{Berger.2018,
 abstract = {Titel und Untertitel des Buches zeigen die doppelte Absicht an: durch
eine systematische Beschreibung der intersubjektiven Prozesse, in denen
die Menschen ihr Wissen um die Welt erwerben, es gesellschaftlich verfestigen,
kontrollieren und weitergeben, soll ein neuer Anfang in der
Wissenssoziologie gemacht werden.
Die bisherige Wissenssoziologie, deren Blütezeit im Deutschland der
zwanziger Jahre war und durch die Namen Max Scheler und Karl
Mannheim glanzvoll repräsentiert wird, führte nach Meinung der
Autoren in eine Sackgasse. Der Versuch einer Ehrenrettung der höheren
Wissensformen, der Wissenschaft usw., vor dem Marxschen Satz >die
herrschenden Gedanken sind weiter nichts als der ideelle Ausdruck der
herrschenden materiellen Verhältnisse ... {\flqq} mündete in endlosen Diskussionen
des vielen {\frqq}bürgerlichen {\flqq}, >marxistischen{\flqq} und {\frqq}neo-marxistischen
{\flqq} Denkern so lieben und vertrauten Ideologieproblems. An
ihm sind Berger und Luckmann in diesem Buch desinteressiert. Sie setzen
früher ein. Die Marxsche These {\frqq}das Bewußtsein ist also schon von
vornherein ein gesellschaftliches Produkt{\flqq} definiert für sie das Grundproblem
der Wissenssoziologie, ja der Gesellschaftstheorie überhaupt.
Die Orientierungsweisen {\frqq} Jedermanns{\flqq}, das vortheoretische Wissen im
Alltagsleben, wird so zum Kernproblem der Wissenssoziologie, und
die Ausbildung höherer Wissensformen und der Wissenschaft kann nur
im Rückgriff auf eine allgemeine Theorie des gesellschaftlich bedingten
Wissenserwerbs verstanden werden. Den Zugang zu diesem Kernproblem
finden die Autoren von zwei verschiedenen Seiten. Die Grundlage
ihrer Beschreibung der Strukturen der Erfahrung, der Handlung, der
Kommunikation und des Wissens in der Alltagswelt bildet das großartige
Konzept Busserls, durch die exakten Methoden der Phänomenologie
die universalen Strukturen der Lebenswelt des Menschen freizulegen
und die Fortführung dieses Konzepts durch Alfred Schütz, der in seinen Arbeiten von der Phänomenologie eine Brücke zur Soziologie,
insbesondere der Soziologie Max Webers schlug. Der Ausgangspunkt
in den empirischen Wissenschaften dagegen ist jedoch die moderne
Humanbiologie und die an ihr orientierte philosophische Anthropologie,
repräsentiert vor allem durch Helmuth Plessner. V-.,n dieser
Ausgangsposition aus gelingt es den Autoren, eine Synthese zwischen
der {\frqq}verstehenden{\flqq} Soziologie Max Webers, der {\frqq}positivistischen{\flqq}
Soziologie Durkheims, der Institutionstheorie Gehlens und der Sozialpsychologie
- in der sie vor allem die Theorien George Herbert Meads
fortentwickeln - herzustellen.
{\frqq}Die{\flqq} Gesellschaft hat eine doppelgr{\"u}ndige Wirklichkeit. Sie ist eine

objektive Gegebenheit infolge der Objektivierung der menschlichen

Erfahrung im gesellschaftlichen Handeln, in sozialen Rollen, Sprache,

Institutionen, Symbolsystemen. Obwohl die letzteren Produktemenschlichen

Handelns sind, gewinnen sie eine Quasi-Autonomie. So {\"u}bt Gesellsch{\~{}}

ft auf den Einzelnen Zwang aus, w{\"a}hrend sie zugleich Bedingung

seiner menschlichen Existenz ist. Denn Gesellschaft ist auch eine subjektive

Wirklichkeit: sie wird vom Einzelnen in Besitz genommen, wie •

sie von ihm Besitz ergreift.

Berger und Luckmann untersuchen das dialektische Verh{\"a}ltnis von

Gesellschaft und Individuum in versdiiedenen Gesellsdiaftstypen, insbesondere

in der industriellen Gesellsdiaft. Sie weisen die unterschiedliche

Rolle, die von Wissenssystemen, {\frqq}gesellschaftlichen{\flqq} Legitimierungsmechanismeo,

religi{\"o}sen Symbolwelten, aber auch von subjektiven

Man{\"o}vern verschiedenster Art in dieser Dialektik gespielt wird. Zentrale

Kategorien der philosophischen Anthropologie und der Ph{\"a}nomenologie

werden in ihrer Bedeutung f{\"u}r die empirische Soziologie

erhellt und in konkreten Analysen angewandt. Dadurch leisten die

Autoren einen Beitrag zur wissenschaftlichen Untersuchung der Conditio

humana.},
 author = {Berger, Peter L. and Luckmann, Thomas and Plessner, Helmuth},
 year = {2018},
 title = {Die gesellschaftliche Konstruktion der Wirklichkeit: Eine Theorie der Wissenssoziologie},
 keywords = {25H;Alltagswelt;gesellschaftliche konstruktion;internalisierung;Wirklichkeit},
 address = {Frankfurt am Main},
 edition = {27. Auflage},
 volume = {6623},
 publisher = {{Fischer Taschenbuch}},
 isbn = {978-3-596-26623-4},
 series = {Fischer},
 file = {20190920{\_}Die gesellschaftliche Konstruktion der Wirklichkeit{\_}Peter L. Berger:Attachments/20190920{\_}Die gesellschaftliche Konstruktion der Wirklichkeit{\_}Peter L. Berger.pdf:application/pdf;25H{\_}berger{\_}07082021{\_}140154:Attachments/25H{\_}berger{\_}07082021{\_}140154.pdf:application/pdf}
