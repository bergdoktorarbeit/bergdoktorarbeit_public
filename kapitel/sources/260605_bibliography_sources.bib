@misc{Lund.2015,
 abstract = {People are increasingly connecting in online social networks where they share content and experiences and consequently influence each other's perceptions and buying behaviour. This poses a distinct challenge for the tourism sector and destination management organisations in particular, as they are responsible for branding and marketing a destination. This thesis conceptualise social media as fluid performative spaces of storytelling. The concepts performance, performativity, mobility and power form a theoretical framework that facilitates an analysis of the politicised storytelling mechanisms in online social networks. It is suggested that DMOs surrender control of the brand and instead concentrate on collaborating with social media storytellers. This may lead to a strengthening of destination narratives.},
 author = {Lund, Niels Frederik},
 year = {2015},
 title = {The mediation of tourism experiences through storytelling in social media: How DMOs can utilise consumer storytelling in their brand narratives},
 url = {\url{https://www.researchgate.net/publication/271162574_The_mediation_of_tourism_experiences_through_storytelling_in_social_media_How_DMOs_can_utilise_consumer_storytelling_in_their_brand_narratives}},
 keywords = {120DT;Brand;consumers;destination;experience;narrative;Social Media;storytelling;Tourism},
 address = {Lugano, Switzerland},
 doi = {\url{10.13140/2.1.2690.0802}},
 institutions = {{ENTER PhD}},
 file = {20190809{\_}The{\_}mediation{\_}of{\_}tourism{\_}experiences{\_}thr:Attachments/20190809{\_}The{\_}mediation{\_}of{\_}tourism{\_}experiences{\_}thr.pdf:application/pdf;120DT{\_}The mediation of tourism experiences through storytelling in social media{\_}lund:Attachments/120DT{\_}The mediation of tourism experiences through storytelling in social media{\_}lund.pdf:application/pdf}
