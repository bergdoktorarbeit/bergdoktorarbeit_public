@phdthesis{Bocher.2018,
 abstract = {Train stations as well as cinema are places of mobility. Trains and movies transfer people to different places and open up new perspectives. In this sense the cinema screen can be compared to a window of a moving train. Movies, traveling and transportation mirrors the way we see the world and change it in the process. The city of Los Angeles can be seen as the central station of movie making in the world, which at the same time features Union Station as the last great transportation center. We chose Los Angeles' Union Station because it is not only the last Grand Station of America, but also one of the most filmed train station in the world. In this paper we explore the connection between Union Station as a motion picture star and a transportation hub for the Western US. More specifically we interrogate how and why Union Station is an ongoing film location for Hollywood. To accomplish our goal, we acquired data from Film L.A. That documented film occurrences in Los Angeles from 2008 to 2012. This data was geocoded into arcGIS which allowed us to examine filming in the neighborhood and related production locations to Union Station. Following this we performed field observations, qualitative interviews and archival interviews at Union Station and LA Downtown library. The cinematic significance to LA cannot be overstated. Build to be the symbolic grand doorsteps of LA, Union Station continues to provide this role through cinema.},
 author = {B{\"o}cher, Daniel and Pasternak, Estera},
 year = {2018},
 title = {Los Angeles Union Station: A Railway and Cinematic Star},
 keywords = {10H;architecture;central station;Cinema History;Hollywood;LA union station;Los Angeles;Neighborhood;Onlocation;Onlocation filming;Railway history;Train station},
 address = {Mainz},
 urldate = {17.06.2021},
 publisher = {Geographisches Institut Mainz},
 school = {{Johannes Gutenberg Universit{\"a}t}},
 type = {Forschungsarbeit},
 file = {10H{\_}b{\"o}cher{\_}07082021{\_}131925:Attachments/10H{\_}b{\"o}cher{\_}07082021{\_}131925.pdf:application/pdf;Research Paper Los Angeles Union Station Boecher{\_}Pasternak:Attachments/Research Paper Los Angeles Union Station Boecher{\_}Pasternak.pdf:application/pdf}
}


@phdthesis{Bocher.09.07.2018,
 abstract = {Die Arbeit besch{\"a}ftigt sich mit dem Thema Screentourismus in seiner Auspr{\"a}gung der Postmoderne. Dabei setzt die Theorie den Kontext und eine eigene qualitative Studie zeigt die Weiterentwicklung von Reisen, Medien und Massentourismus. Die Arbeit soll die Kommunikationsstrategien der einzelnen Akteure (Fan-Touristen und Destination Marketing) erfassen, analysieren und miteinander in Relation setzten. Die Ergebnisse der Studie sollen in die gr{\"o}{\ss}ere Entwicklung von Medien, Massentourismus und Reisen eingeordnet werden. Die Theoretische Basis sind Gedanken rund um die Filmgeographie und das Verh{\"a}ltnis von Medien und Raum im Postfaktischen-Zeitalter. Die Texte von BEETON, ESCHER, KIRBY, WENZEL und ZIMMERMANN bilden dabei das Grundger{\"u}st der Theoretischen {\"U}berlegung, ausgehend vom Protocinema. Bei der Nutzung von Sozialen Medien im Screentoruismus befinden sich diese in einer Linie mit einer Entwicklung die mit der Industrialisierung begonnen hat. Heute sind wir angekommen beim Posttourist der fast nicht mehr wei{\ss} was Echt und was Fiktional ist. Die Ergebnisse best{\"a}tigen die Thesen und geben Hinweise auf detailierte Auswirkungen des Screentourismus auf die Destinationen, die mediatisierte und medialisierte Sicht der Welt.},
 author = {B{\"o}cher, Daniel},
 year = {09.07.2018},
 title = {Screentourismus in Dubrovnik: Vom Protocinema bis zur Social-Media-Kommunikation von Game-of-Thrones-Drehorten},
 keywords = {30.1H;digitization;Film tourism;film-induced tourism;filmtourismus;Industrialisierung;Medialisierung;Mediatisierung;Medium-is-the-massage;Postfaktisch;postmodern;Post-tourism;Protocinema;screen tourism;Time-space-compression;Universalmonitor},
 address = {Mainz},
 publisher = {Geographisches Institut},
 school = {{Johannes Gutenberg Universit{\"a}t}},
 type = {Masterarbeit},
 file = {Masterarbeit{\_}Screentourismus in Dubrovnik{\_}Daniel B{\"o}cher:Attachments/Masterarbeit{\_}Screentourismus in Dubrovnik{\_}Daniel B{\"o}cher.pdf:application/pdf}
