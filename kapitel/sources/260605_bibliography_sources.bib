@article{Morris.2021,
 abstract = {{\textquotedbl}Fake News{\textquotedbl} has been a frequent topic in the last couple of years. The phenomenon has particularly been cited with regards to the election of Donald Trump to the presidency of the United States. The creation of {\textquotedbl}post truth{\textquotedbl} reports that are disseminated via the Web and social media has been treated as something new, a product of the digital age, and a reason to be concerned about the effects of online technology. However, this paper argues that fake news should be considered as part of a continuum with forms of media that went before in the 20th Century, and the general trend of postmodernity detailed by Baudrillard. The simulation of communications media and mass reproduction was already evident and has merely progressed in the digital age rather than the latter providing a wholly new context. The paper concludes by asking whether the political havoc caused by fake news has an antidote, when it appears to be a by-product of media simulacra's inherent lack of connection to the real. In a communications landscape where the misrepresentations of the so-called {\textquotedbl}Mainstream Media{\textquotedbl} are decried using even more questionable {\textquotedbl}memes{\textquotedbl} on social media, is there any possibility for truth?},
 author = {Morris, James},
 year = {2021},
 title = {Simulacra in the Age of Social Media: Baudrillard as the Prophet of Fake News},
 keywords = {188.20SM;Algorithmic Governance;Attention Economy;Baudrillard;disinformation;Donald Trump;fake news;hyperreality;network;post modernity;post truth;post-truth;simulacra;simulation;Social Media;Surveillance Capitalism},
 pages = {319--336},
 volume = {45},
 number = {4},
 issn = {0196-8599},
 journal = {Journal of Communication Inquiry},
 doi = {\url{10.1177/0196859920977154}},
 file = {241220{\_}Simulacra in the Age of Social Media - Baudrillard as the Prophet of Fake News{\_}Morris (2020){\_}simulation:Attachments/241220{\_}Simulacra in the Age of Social Media - Baudrillard as the Prophet of Fake News{\_}Morris (2020){\_}simulation.pdf:application/pdf;250511{\_}Simulacra in the Age of Social Media - Baudrillard as the Prophet of Fake News{\_}Morris:Attachments/250511{\_}Simulacra in the Age of Social Media - Baudrillard as the Prophet of Fake News{\_}Morris.pdf:application/pdf}
}



@book{Mclntyre.2018,
 abstract = {{\textquotedbl}Are we living in a post-truth world, where {\textquotedbl}alternative facts{\textquotedbl} replace actual facts and feelings have more weight than evidence? How did we get here? In this volume in the MIT Press Essential Knowledge series, Lee McIntyre traces the development of the post-truth phenomenon from science denial through the rise of {\textquotedbl}fake news,{\textquotedbl} from our psychological blind spots to the public's retreat into information silos. What, exactly, is post-truth? Is it wishful thinking, political spin, mass delusion, bold-faced lying? McIntyre analyzes recent examples--claims about inauguration crowd size, crime statistics, and the popular vote--and finds that post-truth is an assertion of ideological supremacy by which its practitioners try to compel someone to believe something regardless of the evidence. Yet post-truth didn't begin with the 2016 election; the denial of scientific facts about smoking, evolution, vaccines, and climate change offers a road map for more widespread fact denial. Add to this the wired-in cognitive biases that make us feel that our conclusions are based on good reasoning even when they are not, the decline of traditional media and the rise of social media, and the emergence of fake news as a political tool, and we have the ideal conditions for post-truth. McIntyre also argues provocatively that the right wing borrowed from postmodernism--specifically, the idea that there is no such thing as objective truth--in its attacks on science and facts. McIntyre argues that we can fight post-truth, and that the first step in fighting post-truth is to understand it{\textquotedbl}--},
 author = {Mclntyre, Lee},
 year = {2018},
 title = {Post-truth},
 url = {\url{https://ebookcentral.proquest.com/lib/kxp/detail.action?docID=5294979}},
 keywords = {30.56H;alternative facts;development;era;evidence;facts;fake news;feeling;post truth;science denial},
 address = {Cambridge},
 publisher = {{MIT Press}},
 isbn = {9780262345972},
 series = {The MIT Press Essential Knowledge Series},
 doi = {\url{10.7551/mitpress/11483.001.0001}},
 file = {Mclntyre 2018 - Post-truth:Attachments/Mclntyre 2018 - Post-truth.pdf:application/pdf}
}


