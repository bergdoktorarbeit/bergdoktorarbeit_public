\ProvidesFile{db_citation_style.bbx}

\RequireBibliographyStyle{authoryear}


\DeclareSortingTemplate{typenyt}{
  \sort{
    \field{entrytype}
  }
  \sort{
    \field{presort}
  }
  \sort[final]{
    \field{sortkey}
  }
  \sort{
    \field{sortname}
    \field{author}
    \field{editor}
    \field{translator}
  }
  \sort{
    \field{sortyear}
    \field{year}
  }
  \sort{
    \field{sorttitle}
    \field{title}
  }
}

\ExecuteBibliographyOptions{sorting=typenyt}

\DeclareBibliographyCategory{Books_or_Collections}
\DeclareBibliographyCategory{Articles_in_Collections_or_Proceedings}
\DeclareBibliographyCategory{Articles_in_Journals_or_Newspapers}
\DeclareBibliographyCategory{Websites}
\DeclareBibliographyCategory{Motion_pictures}
\DeclareBibliographyCategory{Maps}
\DeclareBibliographyCategory{Academic_Publications}
\DeclareBibliographyCategory{Presentations_or_Conference_Proceedings}
\DeclareBibliographyCategory{Audio_and_Video_Recordings_in_Radio_TV_or_Web}
\DeclareBibliographyCategory{Gray_Literature_or_Reports}
\DeclareBibliographyCategory{Personal_Communication_Interviews_or_Own_sources}

\DeclareBibliographyDriver{dbbook}{%
  \usebibmacro{bibindex}%
  \usebibmacro{begentry}%
  \printnames{author}%
  \space
  \mkbibparens{\printfield{year}}%
  \addcolon\space
  \printfield{title}%
  \adddot\space
  \printfield{edition}%
  \adddot\space
  \printlist{location}%
  \usebibmacro{finentry}% 
}

\DeclareBibliographyDriver{dbcollection}{%
  \usebibmacro{bibindex}%
  \usebibmacro{begentry}%
  \printnames{author}%
  \space
  \mkbibparens{\printfield{year}}%
  \addcolon\space
  \printfield{title}%
  \adddot\space
  \printtext{In}
  \addcolon\space
  \printnames{editor}%
  \space
  \printtext{(editor)}\addcolon\space
  \printfield{booktitle}%
  \adddot\space
  \printfield{edition}%
  \adddot\space
  \printlist{location}%
  \addcolon\space
  \printfield{pages}%
  \usebibmacro{finentry}% 
}

\DeclareBibliographyDriver{dbarticle}{%
  \usebibmacro{bibindex}%
  \usebibmacro{begentry}%
  \printnames{author}%
  \space
  \mkbibparens{\printfield{year}}%
  \addcolon\space
  \printfield{title}%
  \adddot\space
  \printtext{In}\addcolon\space
  \printfield{journaltitle}%
  \space
  \printfield{volume}%
  \space
  \mkbibparens{\printfield{number}}%
  \addcolon\space
  \printfield{pages}%
  \adddot\space
  \printfield{doi}%
  \finentry% 
}

\DeclareBibliographyDriver{dbweb}{%
  \usebibmacro{bibindex}%
  \usebibmacro{begentry}%
  \printnames{author}%
  \space
  \mkbibparens{\printfield{year}}%
  \addcolon\space
  \printfield{title}%
  \adddot\space
  \printtext{Online}\addcolon\space
  \printfield{url}%
  \space
  \mkbibparens{%
    \printtext{visited on}
    \space
    \mkdayzeros{\thefield{urlday}}.%
    \mkmonthzeros{\thefield{urlmonth}}.%
    \thefield{urlyear}%
  }%
  \usebibmacro{finentry}% 
}

\DeclareBibliographyDriver{dbmovie}{%
  \usebibmacro{bibindex}%
  \usebibmacro{begentry}%
  \printnames{author}%
  \space
  \mkbibparens{\printfield{year}}%
  \addcolon\space
  \printfield{title}%
  \adddot\space
  \printfield{usera}%
  \printfield{length}%
  \space 
  \printtext{minutes}\adddot\space
  \printtext{Online}\addcolon\space
  \printfield{url}%
  \space
  \mkbibparens{%
    \printtext{visited on}
    \space
    \mkdayzeros{\thefield{urlday}}.%
    \mkmonthzeros{\thefield{urlmonth}}.%
    \thefield{urlyear}%
  }%
  \usebibmacro{finentry}% 
}

